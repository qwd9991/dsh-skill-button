{
  "name": "@dsh-external/dsh-skill-button",
  "version": "0.0.1",
  "description": "DSH Input Box Multi-Select Skill Button Plugin",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwd9991/dsh-skill-button.git"
  },
  "bugs": {
    "url": "https://github.com/qwd9991/dsh-skill-button/issues"
  },
  "homepage": "https://github.com/qwd9991/dsh-skill-button#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "skill",
    "plugin",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "cordis": "4.0.0-rc.9",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:dsh": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
